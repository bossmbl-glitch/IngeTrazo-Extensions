# Python cache and generated bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local Python environments
.venv/
venv/
env/

# Local machine artifacts
Thumbs.db
.DS_Store
*.tmp
*.temp
*.bak
*~

# Sensitive local configuration - keep example files in version control
.env
.env.*
!.env.example
!.env.sample

# Do NOT ignore .py, .json, .png, .igz, or project assets:
# some extensions rely on those files to load correctly.
